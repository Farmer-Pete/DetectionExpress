{
  "name": "detection-express",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "bin": {
    "detection-express": "./dd-dev.mjs"
  },
  "files": [
    "dd-dev.mjs",
    "dist-devkit"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:static",
    "build:static": "tsc --noEmit && vite build --mode static",
    "build:devkit": "vite build --mode devkit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "knip": "knip",
    "verify:static": "tsx scripts/verify-static.ts",
    "verify:worker-build": "tsx scripts/verify-worker-build.ts",
    "pack:check": "tsx scripts/verify-pack.ts",
    "m1:check": "tsx scripts/m1-calibrate-check.ts",
    "audit": "pnpm audit --audit-level=high",
    "prepack": "pnpm run build:devkit",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@xyflow/react": "^12.11.3",
    "d3-random": "^3.0.1",
    "fishery": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@testing-library/react": "^16.3.2",
    "@types/d3-random": "^3.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "happy-dom": "^20.11.6",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  }
}
