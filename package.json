{
  "name": "detection-express",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "detection-express": "./dd-dev.mjs"
  },
  "files": [
    "dd-dev.mjs",
    "dist-devkit"
  ],
  "scripts": {
    "dev": "PUBLIC_DEV_KIT=false bun ./index.html",
    "build": "bun run build:static",
    "build:static": "tsc --noEmit && rm -rf dist && bun build ./index.html --define 'process.env.PUBLIC_DEV_KIT=\"false\"' --minify --outdir dist && bun scripts/postbuild.ts",
    "build:devkit": "rm -rf dist-devkit && bun build ./index.html --define 'process.env.PUBLIC_DEV_KIT=\"true\"' --minify --outdir dist-devkit",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src ./dd-dev.test.mjs",
    "test:watch": "bun test ./src ./dd-dev.test.mjs --watch",
    "lint": "biome check .",
    "format": "biome check --write .",
    "knip": "knip",
    "verify:static": "bun scripts/verify-static.ts",
    "pack": "bun run build:devkit && bun pm pack --dry-run --ignore-scripts",
    "audit": "bun audit --audit-level=high",
    "prepack": "bun run build:devkit",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@xyflow/react": "^12.11.3",
    "d3-random": "^3.0.1",
    "fishery": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@happy-dom/global-registrator": "^20.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.2.0",
    "@types/d3-random": "^3.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "typescript": "~6.0.2"
  }
}
