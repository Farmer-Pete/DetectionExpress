{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detectionexpress.game/schemas/scenarios.schema.json",
  "title": "Detection Express scenarios",
  "description": "The catalogue of hunts, sorted from easiest to hardest. Each scenario pairs a snarky introduction with a plain-language security briefing and links to read more.",
  "type": "object",
  "additionalProperties": false,
  "required": ["difficultyScale", "scenarios"],
  "properties": {
    "$schema": { "type": "string" },
    "difficultyScale": {
      "type": "array",
      "description": "The five difficulty tiers and the detection logic shape each one implies.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stars", "label", "meaning"],
        "properties": {
          "stars": { "type": "integer", "minimum": 1, "maximum": 5 },
          "label": { "type": "string" },
          "meaning": { "type": "string" }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "description": "Sorted by difficulty.stars ascending.",
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "difficulty", "sensors", "flavor", "security", "resources"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "difficulty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stars", "label", "shape"],
          "properties": {
            "stars": { "type": "integer", "minimum": 1, "maximum": 5 },
            "label": { "type": "string" },
            "shape": {
              "type": "string",
              "description": "The detection logic shape, which is what makes the scenario easy or hard to write a Rule for."
            }
          }
        },
        "sensors": {
          "type": "array",
          "description": "Sensor ids this scenario reads. Cross-reference sensors.json.",
          "items": { "type": "string" },
          "minItems": 1
        },
        "flavor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tagline", "intro"],
          "properties": {
            "tagline": {
              "type": "string",
              "description": "One snarky line for the level-select screen."
            },
            "intro": {
              "type": "string",
              "description": "The quirky briefing that greets the player before they touch the Rule."
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": ["realWorldConcept", "briefing"],
          "properties": {
            "realWorldConcept": {
              "type": "string",
              "description": "The genuine security detection this scenario teaches."
            },
            "briefing": {
              "type": "string",
              "description": "A serious explanation in Simple Technical English. Short sentences. It uses the metro metaphor to explain the real security concept."
            },
            "mitre": {
              "type": "array",
              "description": "MITRE ATT&CK technique ids, where one applies. Enterprise unless marked ICS.",
              "items": { "type": "string" }
            }
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "description": "Places to read more about the real detection.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    }
  }
}
