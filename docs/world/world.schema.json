{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detectionexpress.game/schemas/world.schema.json",
  "title": "Detection Express world",
  "description": "The metro network the player defends: its trust zones, lines, stations, staff sites, and the control center.",
  "type": "object",
  "additionalProperties": false,
  "required": ["zones", "lines", "stations", "sites", "controlCenter", "doors"],
  "properties": {
    "$schema": { "type": "string" },
    "zones": {
      "type": "array",
      "description": "The trust ladder. A zone is a layer of access, not a place on the map. Every site stacks several zones.",
      "items": { "$ref": "#/$defs/zone" }
    },
    "lines": {
      "type": "array",
      "items": { "$ref": "#/$defs/line" }
    },
    "stations": {
      "type": "array",
      "description": "Passenger stops. A station on two or more lines is an interchange.",
      "items": { "$ref": "#/$defs/station" }
    },
    "sites": {
      "type": "array",
      "description": "Staff-only facilities off the passenger map: depots, signal cabins, substations.",
      "items": { "$ref": "#/$defs/site" }
    },
    "controlCenter": { "$ref": "#/$defs/controlCenter" },
    "doors": {
      "type": "array",
      "description": "Access-controlled doors. Each guards one zone at a site or the control center; its grade is that zone's trust level, derived not stored.",
      "items": { "$ref": "#/$defs/door" }
    }
  },
  "$defs": {
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "trustLevel",
        "area",
        "whoBelongs",
        "securityParallel",
        "description"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^z[0-4]$" },
        "name": { "type": "string" },
        "trustLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "0 is public, 4 is the control floor. Crossing up a level should cost more proof."
        },
        "area": {
          "type": "string",
          "description": "The physical part of the station or site this zone covers."
        },
        "whoBelongs": { "type": "string" },
        "securityParallel": {
          "type": "string",
          "description": "The real network or data boundary this zone stands in for."
        },
        "description": { "type": "string" }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "color", "stations", "loop", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z-]+$" },
        "name": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "stations": {
          "type": "array",
          "description": "Station ids in running order.",
          "items": { "type": "string" },
          "minItems": 2
        },
        "loop": { "type": "boolean", "description": "True if the line runs a closed loop." },
        "description": { "type": "string" }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "lines", "interchange", "connections", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]{3}$" },
        "name": { "type": "string" },
        "lines": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "interchange": {
          "type": "boolean",
          "description": "True when two or more lines meet here."
        },
        "connections": {
          "type": "array",
          "description": "Adjacent stations and the ride time between them, in minutes. This is the travel-time map the geography hunts read.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to", "line", "minutes"],
            "properties": {
              "to": { "type": "string" },
              "line": { "type": "string" },
              "minutes": { "type": "number", "minimum": 0 }
            }
          }
        },
        "description": { "type": "string" }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "zonesPresent", "nearestStation", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["depot", "signal-cabin", "substation"] },
        "zonesPresent": { "type": "array", "items": { "type": "string" } },
        "nearestStation": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "controlCenter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "zonesPresent", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "const": "control-center" },
        "zonesPresent": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" }
      }
    },
    "door": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "locationType", "name", "zone"],
      "properties": {
        "location": {
          "type": "string",
          "description": "The id of the site or control center the door sits at."
        },
        "locationType": {
          "type": "string",
          "enum": ["site", "control-center"],
          "description": "Which list `location` resolves against."
        },
        "name": { "type": "string", "description": "The door name, e.g. MAIN." },
        "zone": {
          "type": "string",
          "pattern": "^z[0-4]$",
          "description": "The zone the door guards. Its grade is that zone's trust level."
        }
      }
    }
  }
}
